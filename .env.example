# Use PostgreSQL you control. Never commit real values.
DATABASE_URL=postgresql://localhost/learning_studio
BETTER_AUTH_URL=http://localhost:3000
# Generate separate high-entropy values, for example: openssl rand -hex 32
BETTER_AUTH_SECRET=
FAMILY_SETUP_CODE=
# One invited parent email for a private family. Comma-separated invitations are
# supported for isolated multi-family authorization testing.
FAMILY_SETUP_EMAILS=
# Native hourly cleanup credential, independent of family and model access.
CRON_SECRET=
# No AI provider key is needed for local fictional fixtures.
# Activities expire at a fixed age (default/max 24 hours). Shorter values are
# supported for deployments and isolated expiry scenarios.
TUTOR_SESSION_RETENTION_SECONDS=86400
# Controlled fictional Tutor HTTP endpoint, development only. Must use
# http://127.0.0.1:<port>. Ignored in production; live dispatch has separate gates.
# Tests supply an isolated service; this is not a live provider credential.
TUTOR_PREVIEW_URL=
# Live access stays closed until the parent/operator supplies verified evidence.
# Server-only: never NEXT_PUBLIC_. Do not copy the test fixtures into a live setup.
OPENAI_API_KEY=
# Funding JSON requires actual grant expiresAt and explicit evidenceExpiresAt.
# checkedAt is an audit timestamp, not a 15-minute reapproval deadline.
# Only otherConsumers:"none", usageBoundary:"exclusive_app_ledger" is supported.
# Verify exclusive organization usage and reconcile all off-ledger liabilities.
TUTOR_FUNDING_EVIDENCE=
TUTOR_RETENTION_EVIDENCE=
# Hosted cleanup observed natively; telemetry controls audited; recovery window
# verified/disclosed; restore procedure documented. See docs/pilot-operations.md.
TUTOR_APPLICATION_RETENTION_EVIDENCE=
# Evidence schema, conservative reservations and final pilot gates:
# docs/pilot-operations.md and docs/ticket-drafts/03-verification.md
# Audio input additionally needs transcriptionsApproved:true in the verified
# project retention evidence. Read-aloud uses an explicitly local device voice.
# Speech contract and supported computer limits: docs/ticket-drafts/09-verification.md

# Provider retention must separately approve Responses images, audio
# transcription and Responses web search. No flag is evidence by itself.
# Deployment fixture URLs are never a production/live fallback.
